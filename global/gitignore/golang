# `makefiles/golang.mk` sets `REPORT_PATH ?= ./reports`, so Go projects collect tool
# reports here rather than under `build/`.
/reports/

# Written at the repository root by `global/scripts/languages/golang/test/run.sh`.
# The unit/integration pairs are the per-phase outputs; the unsuffixed files are the
# merged results the quality gate and the coverage report read.
/junit-unit.xml
/junit-integration.xml
/junit.xml
/unit_coverage.txt
/integration_coverage.txt
/coverage.out
/coverage.txt
/coverage.xml
/cobertura.xml
# Written by the same runner after a run narrowed to the affected packages, for the
# coverage gate that reads it.
/go-test-selection.txt

# `global/scripts/languages/golang/golangci-lint/run.sh` (`make lint`) installs the pinned
# golangci-lint at `./bin/golangci-lint` when no binary of that version is on PATH, staging it
# under a temporary name beside it first. Only those names: the rest of `bin/` is the project's.
/bin/golangci-lint
/bin/.golangci-lint.*

# `global/scripts/shared/go-modcache.sh` falls back to GOPATH=$(pwd)/.go when none is exported --
# Go's own default on a developer's machine, where GOPATH is usually unset -- so `make test` and
# `make cyclonedx` keep a whole module cache inside the project.
/.go/
