# Python bytecode caches produced by the stdlib helper scripts
# (global/scripts/languages/terraform/{order-check,tftest-gen}/*.py)
__pycache__/
*.py[cod]

# Local report output emitted by the scripts when run at a repo root
build/reports/

# Compiled tool binaries. `bin/golangci-lint` and the tor-proxy health binary were
# committed by accident and carried ~45 MB through every clone until they were purged
# from history; ignoring the directory keeps a stray `make` run from re-adding them.
bin/

# `global/scripts/tools/semgrep/run.sh` copies its default `.semgrepignore` here when the
# project it scans ships none, and removes it again only on the way out -- four
# install-failure paths and any interruption of the scan leave it behind. This repository
# runs its own runners at its own root, so it has the same exposure as a consumer, where
# `global/gitignore/common` now covers it.
.semgrepignore

# Test, coverage and SAST output written to the repo root when the scripts are run
# from a project that does not set REPORT_PATH. `build/reports/` above covers the
# normal case; these are the root-level fallbacks.
/cobertura.xml
/coverage.txt
/coverage.xml
/junit.xml
/reports/
